{
  "name": "@s3nd/react",
  "version": "0.1.0",
  "description": "React hooks for s3nd transfers: send a snapshot or a file, read a code back, and a sync code input that repairs what the user typed.",
  "keywords": [
    "s3nd",
    "react",
    "hooks",
    "local-first",
    "indexeddb",
    "sync",
    "transfer",
    "typescript"
  ],
  "license": "MIT",
  "author": "Abderrahmane Mouzoune",
  "homepage": "https://github.com/AbderrahmaneMouzoune/bucketcode/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbderrahmaneMouzoune/bucketcode.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/AbderrahmaneMouzoune/bucketcode/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:exports": "publint --strict && attw --pack .",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@s3nd/protocol": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.0.0",
    "publint": "^0.3.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
