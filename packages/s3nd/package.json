{
  "name": "s3nd",
  "version": "0.1.0",
  "description": "Move a local-first app's data between devices through your own S3 bucket: snapshots, sync codes and a transfer handler. Works with AWS S3, Cloudflare R2, MinIO and any S3-compatible storage.",
  "keywords": [
    "s3",
    "upload",
    "aws",
    "r2",
    "minio",
    "storage",
    "bucket",
    "local-first",
    "sync",
    "indexeddb",
    "nextjs",
    "typescript"
  ],
  "license": "MIT",
  "author": "Abderrahmane Mouzoune",
  "homepage": "https://github.com/AbderrahmaneMouzoune/bucketcode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbderrahmaneMouzoune/bucketcode.git",
    "directory": "packages/s3nd"
  },
  "bugs": {
    "url": "https://github.com/AbderrahmaneMouzoune/bucketcode/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:exports": "publint --strict && attw --pack .",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@s3nd/protocol": "^0.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
