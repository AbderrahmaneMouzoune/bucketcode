{
  "name": "@s3nd/cli",
  "version": "0.1.0",
  "description": "The s3nd command line: move a file between machines with a code, and check that a bucket is actually set up to hold transfers.",
  "keywords": [
    "s3nd",
    "cli",
    "s3",
    "transfer",
    "file-transfer",
    "local-first"
  ],
  "license": "MIT",
  "author": "Abderrahmane Mouzoune",
  "homepage": "https://github.com/AbderrahmaneMouzoune/bucketcode/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbderrahmaneMouzoune/bucketcode.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/AbderrahmaneMouzoune/bucketcode/issues"
  },
  "type": "module",
  "bin": {
    "s3nd": "./dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@s3nd/protocol": "^0.1.0",
    "s3nd": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
